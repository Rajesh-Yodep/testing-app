# Copy to .env and fill in. `shopify app dev` injects the SHOPIFY_* vars and SCOPES
# automatically in development; set them yourself in production.

# --- MongoDB ---
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=b2b_register_app

# --- Local Postman testing only; never use this token in production ---
API_TEST_TOKEN=

# --- Shopify (production only) ---
# SHOPIFY_API_KEY=
# SHOPIFY_API_SECRET=
# SHOPIFY_APP_URL=
# SCOPES=write_products,write_metaobjects,write_metaobject_definitions,read_users,write_customers,read_customers
# SHOP_CUSTOM_DOMAIN=
