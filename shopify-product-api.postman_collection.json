{
  "info": {
    "name": "B2B Register App - All APIs",
    "description": "Full app API collection covering Shopify read APIs, product APIs, customer APIs, and store APIs.\n\nRoutes:\n- /api/shopify/payment-terms\n- /api/shopify/products\n- /api/shopify/product\n- /api/product/create\n- /api/product/update\n- /api/product/delete\n- /api/product/assign-collection\n- /api/product/remove-collection\n- /api/product/publish\n- /api/product/unpublish\n- /api/customer/create\n- /api/customer/user-create\n- /api/customer/salesrep-create\n- /api/store/info\n- /api/store/create\n- /api/store/update\n\nNote: Shopify ProductCreateInput does not accept direct options, variants, images, or collectionIds. Use separate collection/media attach operations.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "b2b-register-app-all-apis"
  },
  "item": [
    {
      "name": "01. Shopify Read APIs",
      "item": [
        {
          "name": "Shopify - Get payment terms",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{apiToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/shopify/payment-terms?shop={{shop}}",
              "protocol": "http",
              "host": ["{{baseUrl}}"],
              "path": ["api", "shopify", "payment-terms"],
              "query": [
                { "key": "shop", "value": "{{shop}}" }
              ]
            }
          }
        },
        {
          "name": "Shopify - Get products list",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{apiToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/shopify/products?shop={{shop}}&first=10&sortKey=CREATED_AT&reverse=false",
              "protocol": "http",
              "host": ["{{baseUrl}}"],
              "path": ["api", "shopify", "products"],
              "query": [
                { "key": "shop", "value": "{{shop}}" },
                { "key": "first", "value": "10" },
                { "key": "sortKey", "value": "CREATED_AT" },
                { "key": "reverse", "value": "false" }
              ]
            }
          }
        },
        {
          "name": "Shopify - Get product detail by ID",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{apiToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/shopify/product?shop={{shop}}&id={{productId}}",
              "protocol": "http",
              "host": ["{{baseUrl}}"],
              "path": ["api", "shopify", "product"],
              "query": [
                { "key": "shop", "value": "{{shop}}" },
                { "key": "id", "value": "{{productId}}" }
              ]
            }
          }
        },
        {
          "name": "Shopify - Get product detail by handle",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{apiToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/shopify/product?shop={{shop}}&handle={{productHandle}}",
              "protocol": "http",
              "host": ["{{baseUrl}}"],
              "path": ["api", "shopify", "product"],
              "query": [
                { "key": "shop", "value": "{{shop}}" },
                { "key": "handle", "value": "{{productHandle}}" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "02. Product APIs",
      "item": [
        {
          "name": "Product - Create",
