            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": \"{{productId}}\",\n  \"collectionIds\": [\"{{collectionId}}\"]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/product/assign-collection?shop={{shop}}",
              "protocol": "http",
