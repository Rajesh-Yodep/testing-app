            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{apiToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Demo Product\",\n  \"bodyHtml\": \"<p>Demo product description</p>\",\n  \"vendor\": \"My Brand\",\n  \"productType\": \"Apparel\",\n  \"status\": \"DRAFT\",\n  \"tags\": \"demo,shopify\",\n  \"handle\": \"demo-product\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/product/create?shop={{shop}}",
              "protocol": "http",
              "host": ["{{baseUrl}}"],
