  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000", "type": "default" },
    { "key": "shop", "value": "your-store.myshopify.com", "type": "default" },
    { "key": "apiToken", "value": "your_api_test_token_here", "type": "secret" },
    { "key": "productId", "value": "gid://shopify/Product/1234567890", "type": "default" },
    { "key": "collectionId", "value": "gid://shopify/Collection/123456789", "type": "default" },
    { "key": "productHandle", "value": "demo-product", "type": "default" },
